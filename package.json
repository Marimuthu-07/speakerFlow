{
  "name": "speakerflow",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop audio output manager for PipeWire and PulseAudio.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:127.0.0.1:5173 && SPEAKERFLOW_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "test": "node scratch/test_motion_engine_unit.cjs",
    "start": "electron .",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.0"
  },
  "devDependencies": {
    "concurrently": "10.0.5",
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "com.speakerflow.app",
    "productName": "SpeakerFlow",
    "directories": {
      "output": "release"
    },
    "linux": {
      "category": "AudioVideo",
      "target": [
        "AppImage",
        "deb"
      ],
      "executableName": "speakerflow",
      "syncDesktopName": true,
      "icon": "assets/icons"
    }
  },
  "author": {
    "name": "Marimuthu",
    "email": "amarimuthu5898@gmail.com"
  },
  "desktopName": "speakerflow"
}
