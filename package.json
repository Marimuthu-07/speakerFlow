{
  "name": "speakerflow",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop audio output manager for PipeWire and PulseAudio.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:127.0.0.1:5173 && SPEAKERFLOW_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:native": "node-gyp rebuild",
    "build": "npm run build:native && vite build",
    "test": "node scratch/test_motion_engine_unit.cjs",
    "start": "electron .",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.0"
  },
  "devDependencies": {
    "concurrently": "10.0.5",
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "node-gyp": "^12.4.0",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "com.speakerflow.app",
    "productName": "SpeakerFlow",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/Release/speakerflow_pipewire.node",
      "package.json",
      "LICENSE"
    ],
    "asarUnpack": [
      "build/Release/speakerflow_pipewire.node"
    ],
    "linux": {
      "category": "AudioVideo",
      "target": [
        "deb"
      ],
      "executableName": "speakerflow",
      "syncDesktopName": true,
      "icon": "assets/icons"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libpipewire-0.3-0"
      ]
    }
  },
  "author": {
    "name": "Marimuthu",
    "email": "amarimuthu5898@gmail.com"
  },
  "desktopName": "speakerflow",
  "license": "MIT"
}
